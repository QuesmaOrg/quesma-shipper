#!/bin/sh
# Installer adapter; lifecycle logic lives in the installed Quesma Shipper binary.
set -eu

USER_HOME=${HOME:-}
case $USER_HOME in /*) ;; *) printf 'Quesma Shipper postinstall: Installer supplied no absolute HOME\n' >&2; exit 1 ;; esac
exec "$USER_HOME/Applications/Quesma Shipper.app/Contents/MacOS/quesma-shipper" postinstall
