#!/bin/sh
# Installer adapter; lifecycle logic lives in the installed Shipper binary.
set -eu

USER_HOME=${HOME:-}
case $USER_HOME in /*) ;; *) printf 'Shipper postinstall: Installer supplied no absolute HOME\n' >&2; exit 1 ;; esac
exec "$USER_HOME/Applications/Shipper.app/Contents/MacOS/shipper" postinstall
