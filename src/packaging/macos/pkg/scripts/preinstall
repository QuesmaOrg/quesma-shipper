#!/bin/sh
# Refuse competing installation methods before Installer replaces any files.
set -eu

die() { printf 'Quesma Shipper: %s; uninstall the previous installation without purging local state before changing installation methods\n' "$*" >&2; exit 1; }

check_link() {
	if [ -e "$1" ] || [ -L "$1" ]; then
		[ -L "$1" ] || die "another installation owns $1"
		target=$(readlink "$1")
		if [ "$target" != "$2" ]; then
			[ "${3:-}" = user ] && [ "$target" = '../../Applications/Quesma Shipper.app/Contents/MacOS/quesma-shipper' ] || die "another installation owns $1"
		fi
	fi
}

check_home() {
	case $1 in /*) ;; *) die 'cannot determine user home' ;; esac
	for path in "$1/Applications/Quesma Shipper.app" "$1/Library/LaunchAgents/com.quesma.shipper.plist"; do
		[ ! -e "$path" ] && [ ! -L "$path" ] || die "a per-user installation exists at $path"
	done
}

if [ "$(id -u)" = 0 ]; then
	[ "${3:-/}" = / ] || die 'only the running system volume is supported'
	check_link /usr/local/bin/quesma-shipper '/Applications/Quesma Shipper.app/Contents/MacOS/quesma-shipper'
	users=$(/usr/bin/dscl . -list /Users UniqueID)
	printf '%s\n' "$users" | while read -r name uid; do
		[ "$uid" -ge 500 ] || continue
		home=$(/usr/bin/dscl . -read "/Users/$name" NFSHomeDirectory)
		home=${home#NFSHomeDirectory: }
		check_home "$home"
	done
	console_uid=$(/usr/bin/stat -f %u /dev/console)
	if [ "$console_uid" -ge 500 ]; then
		console_name=$(/usr/bin/stat -f %Su /dev/console)
		home=$(/usr/bin/dscl /Search -read "/Users/$console_name" NFSHomeDirectory)
		check_home "${home#NFSHomeDirectory: }"
	fi
else
	for path in '/Applications/Quesma Shipper.app' /Library/LaunchAgents/com.quesma.shipper.plist; do
		[ ! -e "$path" ] && [ ! -L "$path" ] || die "a system installation exists at $path"
	done
	INSTALL_HOME=${HOME:-}
	case $INSTALL_HOME in /*) ;; *) die 'Installer supplied no absolute HOME' ;; esac
	executable="$INSTALL_HOME/Applications/Quesma Shipper.app/Contents/MacOS/quesma-shipper"
	check_link "$INSTALL_HOME/.local/bin/quesma-shipper" "$executable" user
	plist="$INSTALL_HOME/Library/LaunchAgents/com.quesma.shipper.plist"
	if [ -e "$plist" ] || [ -L "$plist" ]; then
		previous=$(/usr/bin/plutil -extract ProgramArguments.0 raw -o - "$plist") || die "cannot read $plist"
		[ "$previous" = "$executable" ] || die "another installation owns $plist"
	fi
fi
